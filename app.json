{
  "expo": {
    "name": "KESUUBIT",
    "slug": "kesuubit",
    "scheme": "kesuubit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/kesuubit-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kesuubit.app"
    },
    "android": {
      "package": "com.kesuubit.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kesuubit-icon.png",
        "backgroundColor": "#C93A72"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/kesuubit-icon.png",
      "name": "KESUUBIT",
      "shortName": "KESUUBIT",
      "description": "Instrumentos y accesorios con actitud de banda. Hecho para sonar en Oruro, Bolivia.",
      "themeColor": "#C93A72",
      "backgroundColor": "#FBF7F9",
      "lang": "es"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C93A72",
          "defaultChannel": "kessoku-orders-v1",
          "sounds": [
            "./assets/sounds/kessoku_chime.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrarte qué tan cerca estás de la tienda."
        }
      ],
      "expo-status-bar",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kesuubit-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F9"
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "gifEnabled": false,
            "webpEnabled": false,
            "networkInspector": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4c3eed20-35d4-4496-8aa1-0076f39a2282"
      }
    }
  }
}
